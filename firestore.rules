rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Attendees and authenticated users profile storage
    match /users/{userId} {
      allow read, write: if true;
    }

    // Build With AI RSVPs and Pass Verification
    match /rsvps/{rsvpId} {
      allow read, write: if true;
    }
  }
}
